APP_NAME="SmartGov-Wase"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Lagos
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# -----------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smartgov_wase
DB_USERNAME=root
DB_PASSWORD=

# -----------------------------------------------------------------
# CACHE / QUEUE / SESSION (Redis)
# -----------------------------------------------------------------
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------
# SANCTUM / FRONTEND
# -----------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
SESSION_DOMAIN=localhost

# -----------------------------------------------------------------
# FILE STORAGE
# -----------------------------------------------------------------
FILESYSTEM_DISK=local
# Production: switch to s3 / spaces-compatible object storage
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
# AWS_BUCKET=
# AWS_ENDPOINT=

# -----------------------------------------------------------------
# MAIL
# -----------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@smartgov-wase.gov.ng"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------
# NIN / IDENTITY VERIFICATION (Phase 2 — not wired yet)
# Abstracted behind IdentityVerificationService.
# Do NOT hard-code the platform around a single provider.
# -----------------------------------------------------------------
NIN_PROVIDER=stub
NIN_PROVIDER_BASE_URL=
NIN_PROVIDER_API_KEY=
NIN_PROVIDER_API_SECRET=

# -----------------------------------------------------------------
# PAYMENT GATEWAY (Phase 5 — not wired yet)
# -----------------------------------------------------------------
PAYMENT_GATEWAY=flutterwave
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=

# -----------------------------------------------------------------
# SMS (Phase notifications — optional channel)
# -----------------------------------------------------------------
SMS_PROVIDER=stub
SMS_PROVIDER_API_KEY=

# -----------------------------------------------------------------
# BRANDING (used by document/email templates)
# -----------------------------------------------------------------
BRAND_PRIMARY_GREEN=#0B7A3B
BRAND_DEEP_GREEN=#07552B
BRAND_GOLD_ACCENT=#C9A227
